// Ohnyk — Prisma schema
// Phase 1: authentication + base data model.
// Phase 2: profiles/addresses, discovery (cooks, categories, dishes), cart.
// Phase 3: cook onboarding + verification, menu management (multi-photo,
//          availability schedule), orders (checkout) + cook dashboard.
// Payment, Review arrive in Phases 4+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COOK
  COURIER
  ADMIN
}

// Outcome of the (stubbed) cook verification review.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Operational state of a cook account.
enum CookStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Lifecycle of an order — from checkout, through payment, cooking, and delivery.
enum OrderStatus {
  AWAITING_PAYMENT // created at checkout, before a confirmed payment
  NEW // paid — visible to the cook
  CONFIRMED // cook accepted the order
  PREPARING
  READY // ready for pickup by a courier
  COURIER_ASSIGNED // a courier claimed it
  PICKED_UP // courier collected it from the cook
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

// Payment lifecycle (MonoPay acquiring).
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Courier availability.
enum CourierStatus {
  ONLINE
  OFFLINE
}

// Courier transport (optional).
enum TransportType {
  WALKING
  BICYCLE
  CAR
}

enum DeliveryMethod {
  PICKUP // customer collects from the cook
  COOK_DELIVERY // the cook delivers themselves
  COURIER // a third-party courier delivers
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  fullName     String
  avatar       String? // URL or base64 (Phase 2 — profile management)
  // Favourite cook ids. Kept on User to avoid an extra join for a simple list.
  favoriteCookIds String[] @default([])
  createdAt    DateTime @default(now())

  cookProfile    Cook?
  courierProfile CourierProfile?
  addresses      Address[]
  cart           Cart?
  passwordResets PasswordReset[]
  orders         Order[] // orders placed as a buyer
}

model Cook {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String? // public kitchen name; falls back to user.fullName
  bio         String? // "про себе" / description
  avatar      String? // profile photo — URL or base64
  isVerified  Boolean  @default(false) // kept in sync with verificationStatus (Phase 2 badge)
  rating      Float    @default(0) // average review score
  reviewCount Int      @default(0)
  latitude    Float? // for distance calculation
  longitude   Float?
  city        String   @default("Черкаси")

  // --- Phase 3: onboarding & verification -----------------------------------
  kitchenAddress     String             @default("") // kitchen / pickup address
  deliveryZone       String? // free-text delivery area
  phoneVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationDocUrl String? // uploaded document — personal medical record
  identityDocUrl     String? // passport / driver's licence — identity check
  kitchenPhotoUrl    String? // optional — kitchen photo, builds buyer trust
  kitchenVideoUrl    String? // optional — kitchen video tour, builds buyer trust
  verifiedAt         DateTime?
  verifiedByAdminId  String? // admin user id who approved
  status             CookStatus         @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  dishes Dish[]
  orders Order[] // incoming orders for this cook
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  street     String
  building   String
  apartment  String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id     String @id @default(uuid())
  name   String @unique
  slug   String @unique
  emoji  String // 🥣 Борщ
  dishes Dish[]
}

model Dish {
  id          String    @id @default(uuid())
  cookId      String
  cook        Cook      @relation(fields: [cookId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  image       String? // cover image (URL or base64) — kept for back-compat
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isAvailable Boolean   @default(true)

  // --- Phase 3: availability schedule ---------------------------------------
  availableDays  String[] @default([]) // e.g. ["MON","TUE"], empty = every day
  availableFrom  String? // "HH:mm"
  availableUntil String? // "HH:mm"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  cartItems  CartItem[]
  photos     DishPhoto[]
  orderItems OrderItem[]
}

// Additional dish photos (beyond the cover `Dish.image`).
model DishPhoto {
  id        String   @id @default(uuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([dishId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookId    String? // one cart = one cook at a time
  items     CartItem[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  dishId   String
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([cartId, dishId])
}

model Order {
  id        String      @id @default(uuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cookId    String
  cook      Cook        @relation(fields: [cookId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(AWAITING_PAYMENT)
  // Pricing (see lib/pricing.js). subtotal = cook's dish prices; total = what the
  // customer pays (subtotal + 10% service fee); cookPayout = subtotal − 10%
  // commission; commission = the app's total take (~20% of subtotal).
  subtotal   Float @default(0)
  serviceFee Float @default(0)
  total      Float @default(0) // amount charged to the customer
  cookPayout Float @default(0) // amount the cook earns
  commission Float @default(0) // app's total commission
  addressText String    @default("") // delivery/pickup address snapshot
  note      String? // buyer comment

  // --- Phase 4: delivery scheduling, courier, payment -----------------------
  deliveryMethod DeliveryMethod @default(COURIER) // pickup / cook / courier
  scheduledFor DateTime? // chosen delivery slot
  deliveryLat  Float? // destination coords (for the tracking map)
  deliveryLng  Float?
  courierId    String?
  courier      CourierProfile? @relation(fields: [courierId], references: [id])
  payment      Payment?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([cookId, status])
  @@index([buyerId])
  @@index([courierId, status])
  @@index([status])
}

// Append-only status history for an order (the delivery timeline).
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// One payment per order (MonoPay acquiring). Provider-agnostic fields.
model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            PaymentStatus @default(PENDING)
  amount            Float // in UAH
  provider          String        @default("monopay")
  providerInvoiceId String? // MonoPay invoiceId
  transactionId     String? // provider transaction reference
  rawCallback       Json? // last webhook payload (audit)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  @@index([providerInvoiceId])
}

model CourierProfile {
  id        String        @id @default(uuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transport TransportType? // walking / bicycle / car
  status    CourierStatus @default(OFFLINE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  orders   Order[] // deliveries assigned to this courier
  location CourierLocation?
}

// Last known courier position only (no history — keeps the table small).
model CourierLocation {
  id        String         @id @default(uuid())
  courierId String         @unique
  courier   CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  updatedAt DateTime       @updatedAt
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId        String
  dish          Dish   @relation(fields: [dishId], references: [id])
  nameSnapshot  String // dish name at time of order
  priceSnapshot Float // unit price at time of order
  quantity      Int    @default(1)
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
