// Ohnyk — Prisma schema
// Phase 1: authentication + base data model.
// Phase 2: profiles/addresses, discovery (cooks, categories, dishes), cart.
// Phase 3: cook onboarding + verification, menu management (multi-photo,
//          availability schedule), orders (checkout) + cook dashboard.
// Payment, Review arrive in Phases 4+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COOK
  ADMIN
}

// Outcome of the (stubbed) cook verification review.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Operational state of a cook account.
enum CookStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Lifecycle of an order, from placement to hand-off.
enum OrderStatus {
  NEW
  PREPARING
  READY
  HANDED_OVER
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  fullName     String
  avatar       String? // URL or base64 (Phase 2 — profile management)
  // Favourite cook ids. Kept on User to avoid an extra join for a simple list.
  favoriteCookIds String[] @default([])
  createdAt    DateTime @default(now())

  cookProfile    Cook?
  addresses      Address[]
  cart           Cart?
  passwordResets PasswordReset[]
  orders         Order[] // orders placed as a buyer
}

model Cook {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String? // public kitchen name; falls back to user.fullName
  bio         String? // "про себе" / description
  avatar      String? // profile photo — URL or base64
  isVerified  Boolean  @default(false) // kept in sync with verificationStatus (Phase 2 badge)
  rating      Float    @default(0) // average review score
  reviewCount Int      @default(0)
  latitude    Float? // for distance calculation
  longitude   Float?
  city        String   @default("Черкаси")

  // --- Phase 3: onboarding & verification -----------------------------------
  kitchenAddress     String             @default("") // kitchen / pickup address
  deliveryZone       String? // free-text delivery area
  phoneVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationDocUrl String? // uploaded permit/document
  verifiedAt         DateTime?
  verifiedByAdminId  String? // admin user id who approved
  status             CookStatus         @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  dishes Dish[]
  orders Order[] // incoming orders for this cook
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  street     String
  building   String
  apartment  String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id     String @id @default(uuid())
  name   String @unique
  slug   String @unique
  emoji  String // 🥣 Борщ
  dishes Dish[]
}

model Dish {
  id          String    @id @default(uuid())
  cookId      String
  cook        Cook      @relation(fields: [cookId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  image       String? // cover image (URL or base64) — kept for back-compat
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isAvailable Boolean   @default(true)

  // --- Phase 3: availability schedule ---------------------------------------
  availableDays  String[] @default([]) // e.g. ["MON","TUE"], empty = every day
  availableFrom  String? // "HH:mm"
  availableUntil String? // "HH:mm"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  cartItems  CartItem[]
  photos     DishPhoto[]
  orderItems OrderItem[]
}

// Additional dish photos (beyond the cover `Dish.image`).
model DishPhoto {
  id        String   @id @default(uuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([dishId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookId    String? // one cart = one cook at a time
  items     CartItem[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  dishId   String
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([cartId, dishId])
}

model Order {
  id        String      @id @default(uuid())
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cookId    String
  cook      Cook        @relation(fields: [cookId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(NEW)
  total     Float       @default(0)
  addressText String    @default("") // delivery/pickup address snapshot
  note      String? // buyer comment
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  items OrderItem[]

  @@index([cookId, status])
  @@index([buyerId])
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId        String
  dish          Dish   @relation(fields: [dishId], references: [id])
  nameSnapshot  String // dish name at time of order
  priceSnapshot Float // unit price at time of order
  quantity      Int    @default(1)
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
