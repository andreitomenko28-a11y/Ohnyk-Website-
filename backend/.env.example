# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://ohnyk:ohnyk@localhost:5432/ohnyk?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Set when running behind a reverse proxy so rate limiting sees the real client
# IP (number of proxy hops to trust, usually 1). Leave unset for local dev.
# TRUST_PROXY=1

# Rate limiting (optional overrides; sensible defaults are built in).
# RATE_AUTH_MAX=10          # login/refresh/password-reset per 15 min (failures)
# RATE_REGISTER_MAX=10      # registrations per hour
# RATE_ORDER_MAX=30         # checkouts per hour
# RATE_UPLOAD_MAX=40        # file uploads per 15 min
# RATE_VERIFY_MAX=15        # phone code request/confirm per 15 min
# RATE_GLOBAL_MAX=200       # any API request per minute

# Phone verification (brute-force protection).
# PHONE_CODE_TTL_MS=600000      # code lifetime (default 10 min)
# PHONE_CODE_MAX_ATTEMPTS=5     # wrong guesses before the code locks

# JWT — change these secrets in production!
JWT_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# MonoPay (monobank acquiring) — leave MONO_TOKEN empty to use the built-in
# stub gateway (local /pay page). Set it for real invoices; NEVER commit it.
MONO_TOKEN=""
MONO_API_BASE="https://api.monobank.ua"
# Public origins used to build MonoPay redirect/webhook URLs.
APP_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:4000"
