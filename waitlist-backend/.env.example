# --- Server ---
PORT=4000

# Admin bearer token protecting GET /api/waitlist (CSV export).
# Generate a long random string, e.g.  openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# CORS: the exact origin(s) of the deployed landing page.
# Comma-separated for multiple. Leave empty to allow any origin (dev only).
ALLOWED_ORIGIN=http://localhost:5500

# Max POST /api/waitlist submissions per IP per 15 min window.
RATE_LIMIT_MAX=5

# --- Database (SQLite) ---
# File path relative to the backend root (Prisma resolves it from prisma/).
DATABASE_URL=file:../data/waitlist.db

# --- SMTP (owner notification email) ---
# Any SMTP provider works. Example below is Gmail SMTP (use an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# From address (optional; defaults to SMTP_USER).
SMTP_FROM=Ohnyk Waitlist <your-address@gmail.com>
# Where new-signup notifications are delivered.
NOTIFY_EMAIL=owner@example.com
